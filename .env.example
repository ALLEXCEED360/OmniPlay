# ---------------------------------------------------------------------------
# OMNIPLAY environment
# Copy to .env and fill in. Never commit the filled copy.
# ---------------------------------------------------------------------------

# NODE_ENV is deliberately not set here. Each command sets its own
# (next build wants "production"), and pinning it in .env breaks the
# frontend production build.

# Infrastructure (ports match infrastructure/docker/docker-compose.yml, offset
# from the defaults so they do not collide with an existing local Postgres)
DATABASE_URL="postgresql://omniplay:omniplay@localhost:5433/omniplay?schema=public"
REDIS_URL="redis://localhost:6380"

# Session signing. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# Encrypts provider tokens at rest (AES-256-GCM). Generate with:
#   openssl rand -base64 32
# Rotating this without re-wrapping existing rows makes stored provider
# connections undecryptable and forces every user to reconnect.
CREDENTIAL_ENCRYPTION_KEY=""

# --- Steam ---------------------------------------------------------------
# Web API key: https://steamcommunity.com/dev/apikey
# The realm must be the scheme+host users are returned to, and the return URL
# must sit underneath it or Steam refuses the sign-in.
STEAM_API_KEY=""
STEAM_REALM="http://localhost:4000"
STEAM_RETURN_URL="http://localhost:4000/auth/providers/steam/callback"

# --- Xbox ----------------------------------------------------------------
# Two routes, pick one.
#
# 1. OpenXBL (https://xbl.io) - sign in with your Microsoft account and copy
#    the key. No Azure tenant needed. Free tier allows 150 requests/hour.
OPENXBL_API_KEY=""
#
# 2. Your own Azure app registration. Requires an Azure tenant, which a
#    personal Microsoft account does not have by default.
# Azure app registration (portal.azure.com > App registrations).
# Platform: Web. Redirect URI must match XBOX_REDIRECT_URI exactly.
# Delegated permissions: XboxLive.signin, XboxLive.offline_access.
# A public-client registration needs no secret; leave it blank if so.
XBOX_CLIENT_ID=""
XBOX_CLIENT_SECRET=""
XBOX_REDIRECT_URI="http://localhost:4000/auth/providers/xbox/callback"

# --- IGDB ----------------------------------------------------------------
# Twitch application: dev.twitch.tv/console/apps
# Rate limit is 4 requests/second; the client already throttles to it.
IGDB_CLIENT_ID=""
IGDB_CLIENT_SECRET=""

# --- URLs ----------------------------------------------------------------
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# PlayStation Network. Unofficial: obtained by signing in at playstation.com
# and reading https://ca.account.sony.com/api/v1/ssocookie. Expires ~60 days.
PSN_NPSSO=""
