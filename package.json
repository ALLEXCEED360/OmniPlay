{
  "name": "omniplay",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @omniplay/database generate",
    "db:push": "pnpm --filter @omniplay/database push",
    "db:migrate": "pnpm --filter @omniplay/database migrate",
    "db:seed": "pnpm --filter @omniplay/database seed",
    "db:studio": "pnpm --filter @omniplay/database studio",
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "doctor": "pnpm --filter @omniplay/worker doctor",
    "reset": "pnpm --filter @omniplay/worker reset"
  },
  "devDependencies": {
    "turbo": "^2.5.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@types/node": "^22.15.30",
    "tsx": "^4.20.3"
  }
}
